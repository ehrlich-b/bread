{
  "version": 1, "name": "Imported eight-bit tristate register: all bytes and X/Z",
  "inputs": { "clk": ["clk"], "load": ["load"], "oe": ["oe"], "d": ["d[0]", "d[1]", "d[2]", "d[3]", "d[4]", "d[5]", "d[6]", "d[7]"], "external": ["bus[0]", "bus[1]", "bus[2]", "bus[3]", "bus[4]", "bus[5]", "bus[6]", "bus[7]"] },
  "outputs": { "bus": ["bus[0]", "bus[1]", "bus[2]", "bus[3]", "bus[4]", "bus[5]", "bus[6]", "bus[7]"] },
  "vectors": [
    { "drive": { "clk": 0, "load": 1, "oe": 0, "d": 0 }, "expect": { "bus": "Z" } },
    { "drive": { "oe": 1 }, "clock": "clk", "expect": { "bus": 0 } },
    { "for": { "byte": { "from": 0, "to": 255 } }, "vectors": [{ "drive": { "d": { "var": "byte" } }, "clock": "clk", "expect": { "bus": { "var": "byte" } } }] },
    { "drive": { "load": 0, "d": 0 }, "clock": "clk", "expect": { "bus": 255 } },
    { "drive": { "load": 1, "d": "10XZ01ZX" }, "clock": "clk", "expect": { "bus": "10XZ01ZX" } },
    { "drive": { "oe": 0 }, "expect": { "bus": "Z" } },
    { "drive": { "oe": "X" }, "expect": { "bus": "XXXZXXZX" } },
    { "drive": { "oe": 1, "load": 1, "d": 0 }, "clock": "clk", "expect": { "bus": 0 } },
    { "drive": { "external": 255 }, "expect": { "bus": "X" } },
    { "drive": { "oe": 0 }, "expect": { "bus": 255 } },
    { "drive": { "external": "Z" }, "expect": { "bus": "Z" } }
  ]
}
