{
  "version": 1, "name": "Imported ALU: exhaustive four-bit operands and four-state vectors",
  "inputs": { "a": ["a[0]", "a[1]", "a[2]", "a[3]"], "b": ["b[0]", "b[1]", "b[2]", "b[3]"], "op": ["op[0]", "op[1]"] },
  "outputs": { "y": ["y[0]", "y[1]", "y[2]", "y[3]"], "zero": ["zero"], "parity": ["parity"] },
  "vectors": [
    { "for": { "op": [0, 1, 2, 3], "a": { "from": 0, "to": 15 }, "b": { "from": 0, "to": 15 } }, "vectors": [{ "drive": { "op": { "var": "op" }, "a": { "var": "a" }, "b": { "var": "b" } } }] },
    { "for": { "op": [0, 1, 2, 3], "state": [0, 1, 2] }, "vectors": [{ "drive": { "op": { "var": "op" }, "a": { "table": ["X", "Z", "10X1"], "index": "state" }, "b": 0 } }] },
    { "drive": { "op": "X", "a": 0, "b": 0 }, "expect": { "y": 0, "zero": 1, "parity": 0 } },
    { "drive": { "op": "Z", "a": 15, "b": 5 } },
    { "drive": { "op": "1X", "a": 10, "b": 5 } }
  ]
}
