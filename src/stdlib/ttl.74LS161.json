{
  "$schema": "../../schema/circuit.schema.json",
  "version": 1,
  "kind": "composite",
  "name": "ttl.74LS161",
  "description": "4-bit synchronous binary counter with async clear and synchronous parallel load. /CLR is async (active low) and dominates everything. Otherwise on rising edge of CLK: if /LD=0, load D inputs (sync); else if (ENT AND ENP), increment; else hold. RCO = ENT AND (Q==15). Built from 4 × DFF + a 4-bit ADDER (Q+1 with B=0001) + per-bit hold/count/load mux pair.",
  "components": [
    { "id": "adder",      "type": "prim.ADDER",   "params": { "width": 4 } },
    { "id": "const1_b0",  "type": "prim.CONST_1" },
    { "id": "const0_b1",  "type": "prim.CONST_0" },
    { "id": "const0_b2",  "type": "prim.CONST_0" },
    { "id": "const0_b3",  "type": "prim.CONST_0" },
    { "id": "const0_cin", "type": "prim.CONST_0" },

    { "id": "and_count_en", "type": "prim.AND", "params": { "inputs": 2 } },
    { "id": "and_rco",      "type": "prim.AND", "params": { "inputs": 2 } },

    { "id": "muxc0", "type": "prim.MUX2", "params": { "width": 1 } },
    { "id": "muxc1", "type": "prim.MUX2", "params": { "width": 1 } },
    { "id": "muxc2", "type": "prim.MUX2", "params": { "width": 1 } },
    { "id": "muxc3", "type": "prim.MUX2", "params": { "width": 1 } },

    { "id": "muxl0", "type": "prim.MUX2", "params": { "width": 1 } },
    { "id": "muxl1", "type": "prim.MUX2", "params": { "width": 1 } },
    { "id": "muxl2", "type": "prim.MUX2", "params": { "width": 1 } },
    { "id": "muxl3", "type": "prim.MUX2", "params": { "width": 1 } },

    { "id": "dff0", "type": "prim.DFF", "params": { "clrActiveLow": true } },
    { "id": "dff1", "type": "prim.DFF", "params": { "clrActiveLow": true } },
    { "id": "dff2", "type": "prim.DFF", "params": { "clrActiveLow": true } },
    { "id": "dff3", "type": "prim.DFF", "params": { "clrActiveLow": true } }
  ],
  "nets": [
    { "id": "nA", "endpoints": ["muxl0.A0"] },
    { "id": "nB", "endpoints": ["muxl1.A0"] },
    { "id": "nC", "endpoints": ["muxl2.A0"] },
    { "id": "nD", "endpoints": ["muxl3.A0"] },

    { "id": "nCLK", "endpoints": ["dff0.CLK", "dff1.CLK", "dff2.CLK", "dff3.CLK"] },
    { "id": "nCLR", "endpoints": ["dff0./CLR", "dff1./CLR", "dff2./CLR", "dff3./CLR"] },

    { "id": "nLD",  "endpoints": ["muxl0.S", "muxl1.S", "muxl2.S", "muxl3.S"] },

    { "id": "nENT",     "endpoints": ["and_count_en.A", "and_rco.A"] },
    { "id": "nENP",     "endpoints": ["and_count_en.B"] },
    { "id": "nCountEn", "endpoints": ["and_count_en.Y", "muxc0.S", "muxc1.S", "muxc2.S", "muxc3.S"] },

    { "id": "nB0",  "endpoints": ["const1_b0.Y",  "adder.B0"] },
    { "id": "nB1",  "endpoints": ["const0_b1.Y",  "adder.B1"] },
    { "id": "nB2",  "endpoints": ["const0_b2.Y",  "adder.B2"] },
    { "id": "nB3",  "endpoints": ["const0_b3.Y",  "adder.B3"] },
    { "id": "nCin", "endpoints": ["const0_cin.Y", "adder.Cin"] },

    { "id": "nQ0", "endpoints": ["dff0.Q", "adder.A0", "muxc0.A0"] },
    { "id": "nQ1", "endpoints": ["dff1.Q", "adder.A1", "muxc1.A0"] },
    { "id": "nQ2", "endpoints": ["dff2.Q", "adder.A2", "muxc2.A0"] },
    { "id": "nQ3", "endpoints": ["dff3.Q", "adder.A3", "muxc3.A0"] },

    { "id": "nNext0", "endpoints": ["adder.S0", "muxc0.B0"] },
    { "id": "nNext1", "endpoints": ["adder.S1", "muxc1.B0"] },
    { "id": "nNext2", "endpoints": ["adder.S2", "muxc2.B0"] },
    { "id": "nNext3", "endpoints": ["adder.S3", "muxc3.B0"] },

    { "id": "nHoldOrCount0", "endpoints": ["muxc0.Y0", "muxl0.B0"] },
    { "id": "nHoldOrCount1", "endpoints": ["muxc1.Y0", "muxl1.B0"] },
    { "id": "nHoldOrCount2", "endpoints": ["muxc2.Y0", "muxl2.B0"] },
    { "id": "nHoldOrCount3", "endpoints": ["muxc3.Y0", "muxl3.B0"] },

    { "id": "nD0", "endpoints": ["muxl0.Y0", "dff0.D"] },
    { "id": "nD1", "endpoints": ["muxl1.Y0", "dff1.D"] },
    { "id": "nD2", "endpoints": ["muxl2.Y0", "dff2.D"] },
    { "id": "nD3", "endpoints": ["muxl3.Y0", "dff3.D"] },

    { "id": "nCarryAt15", "endpoints": ["adder.Cout", "and_rco.B"] },
    { "id": "nRCO",       "endpoints": ["and_rco.Y"] }
  ],
  "ports": [
    { "name": "A",    "dir": "in",  "internalNet": "nA" },
    { "name": "B",    "dir": "in",  "internalNet": "nB" },
    { "name": "C",    "dir": "in",  "internalNet": "nC" },
    { "name": "D",    "dir": "in",  "internalNet": "nD" },
    { "name": "CLK",  "dir": "in",  "internalNet": "nCLK" },
    { "name": "/CLR", "dir": "in",  "internalNet": "nCLR" },
    { "name": "/LD",  "dir": "in",  "internalNet": "nLD" },
    { "name": "ENT",  "dir": "in",  "internalNet": "nENT" },
    { "name": "ENP",  "dir": "in",  "internalNet": "nENP" },
    { "name": "QA",   "dir": "out", "internalNet": "nQ0" },
    { "name": "QB",   "dir": "out", "internalNet": "nQ1" },
    { "name": "QC",   "dir": "out", "internalNet": "nQ2" },
    { "name": "QD",   "dir": "out", "internalNet": "nQ3" },
    { "name": "RCO",  "dir": "out", "internalNet": "nRCO" }
  ]
}
