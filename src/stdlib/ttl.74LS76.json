{
  "$schema": "../../schema/circuit.schema.json",
  "version": 1,
  "kind": "composite",
  "name": "ttl.74LS76",
  "description": "Dual JK flip-flop with independent active-low async preset (/PRE) and clear (/CLR). Negative-edge triggered (Q updates on falling edge of CLK). On the active edge: J=0,K=0 hold; J=0,K=1 reset; J=1,K=0 set; J=1,K=1 toggle. Async /PRE and /CLR dominate the clock. Note: with both /PRE and /CLR asserted simultaneously the primitive's DFF resolves CLR-before-PRE (Q=0); the real '76 brings both Q outputs high on that forbidden row. Built as JK-from-D: D = J·Qn + K'·Q, fed into a positive-edge DFF clocked by NOT(CLK).",
  "components": [
    { "id": "inv1_clk", "type": "prim.NOT" },
    { "id": "inv1_k",   "type": "prim.NOT" },
    { "id": "and1_jq",  "type": "prim.AND", "params": { "inputs": 2 } },
    { "id": "and1_kq",  "type": "prim.AND", "params": { "inputs": 2 } },
    { "id": "or1_d",    "type": "prim.OR",  "params": { "inputs": 2 } },
    { "id": "dff1",     "type": "prim.DFF", "params": { "clrActiveLow": true, "preActiveLow": true } },

    { "id": "inv2_clk", "type": "prim.NOT" },
    { "id": "inv2_k",   "type": "prim.NOT" },
    { "id": "and2_jq",  "type": "prim.AND", "params": { "inputs": 2 } },
    { "id": "and2_kq",  "type": "prim.AND", "params": { "inputs": 2 } },
    { "id": "or2_d",    "type": "prim.OR",  "params": { "inputs": 2 } },
    { "id": "dff2",     "type": "prim.DFF", "params": { "clrActiveLow": true, "preActiveLow": true } }
  ],
  "nets": [
    { "id": "n1J",    "endpoints": ["and1_jq.A"] },
    { "id": "n1K",    "endpoints": ["inv1_k.A"] },
    { "id": "n1Kn",   "endpoints": ["inv1_k.Y", "and1_kq.A"] },
    { "id": "n1CLK",  "endpoints": ["inv1_clk.A"] },
    { "id": "n1ClkN", "endpoints": ["inv1_clk.Y", "dff1.CLK"] },
    { "id": "n1PRE",  "endpoints": ["dff1./PRE"] },
    { "id": "n1CLR",  "endpoints": ["dff1./CLR"] },
    { "id": "n1Q",    "endpoints": ["dff1.Q",  "and1_kq.B"] },
    { "id": "n1Qn",   "endpoints": ["dff1.Qn", "and1_jq.B"] },
    { "id": "n1JQ",   "endpoints": ["and1_jq.Y", "or1_d.A"] },
    { "id": "n1KQ",   "endpoints": ["and1_kq.Y", "or1_d.B"] },
    { "id": "n1D",    "endpoints": ["or1_d.Y", "dff1.D"] },

    { "id": "n2J",    "endpoints": ["and2_jq.A"] },
    { "id": "n2K",    "endpoints": ["inv2_k.A"] },
    { "id": "n2Kn",   "endpoints": ["inv2_k.Y", "and2_kq.A"] },
    { "id": "n2CLK",  "endpoints": ["inv2_clk.A"] },
    { "id": "n2ClkN", "endpoints": ["inv2_clk.Y", "dff2.CLK"] },
    { "id": "n2PRE",  "endpoints": ["dff2./PRE"] },
    { "id": "n2CLR",  "endpoints": ["dff2./CLR"] },
    { "id": "n2Q",    "endpoints": ["dff2.Q",  "and2_kq.B"] },
    { "id": "n2Qn",   "endpoints": ["dff2.Qn", "and2_jq.B"] },
    { "id": "n2JQ",   "endpoints": ["and2_jq.Y", "or2_d.A"] },
    { "id": "n2KQ",   "endpoints": ["and2_kq.Y", "or2_d.B"] },
    { "id": "n2D",    "endpoints": ["or2_d.Y", "dff2.D"] }
  ],
  "ports": [
    { "name": "1J",    "dir": "in",  "internalNet": "n1J" },
    { "name": "1K",    "dir": "in",  "internalNet": "n1K" },
    { "name": "1CLK",  "dir": "in",  "internalNet": "n1CLK" },
    { "name": "/1PRE", "dir": "in",  "internalNet": "n1PRE" },
    { "name": "/1CLR", "dir": "in",  "internalNet": "n1CLR" },
    { "name": "1Q",    "dir": "out", "internalNet": "n1Q" },
    { "name": "/1Q",   "dir": "out", "internalNet": "n1Qn" },
    { "name": "2J",    "dir": "in",  "internalNet": "n2J" },
    { "name": "2K",    "dir": "in",  "internalNet": "n2K" },
    { "name": "2CLK",  "dir": "in",  "internalNet": "n2CLK" },
    { "name": "/2PRE", "dir": "in",  "internalNet": "n2PRE" },
    { "name": "/2CLR", "dir": "in",  "internalNet": "n2CLR" },
    { "name": "2Q",    "dir": "out", "internalNet": "n2Q" },
    { "name": "/2Q",   "dir": "out", "internalNet": "n2Qn" }
  ]
}
