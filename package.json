{
  "name": "bread",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:verilog": "node --import tsx scripts/test_verilog.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "demo": "node --import tsx scripts/demo.ts",
    "demo:check": "node --import tsx scripts/demo.ts | diff -u examples/nand_latch.trace.txt -",
    "demo:adder": "node --import tsx scripts/adder_demo.ts",
    "demo:bus": "node --import tsx scripts/register_bus_demo.ts",
    "demo:blink": "node --import tsx scripts/blink_demo.ts",
    "bench:eater": "node --import tsx scripts/bench_eater.ts",
    "check:original": "vitest run src/stdlib/original.programs.test.ts --maxWorkers=2",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
